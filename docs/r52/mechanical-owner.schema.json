{
  "type": "object",
  "properties": {
    "ground_guides": {
      "type": "object",
      "properties": {
        "source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "paths_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "dock_source_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "dock_foundations": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "leg": {
                "type": "string",
                "pattern": "^[A-Za-z0-9_./:-]{1,160}$"
              },
              "foundation_top_m": {
                "type": "number"
              }
            },
            "required": [
              "leg",
              "foundation_top_m"
            ],
            "additionalProperties": false
          },
          "minItems": 1
        },
        "mode": {
          "const": "continuous_upright"
        }
      },
      "required": [
        "source_sha256",
        "paths_sha256"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "required": [
              "mode"
            ]
          },
          "then": {
            "not": {
              "anyOf": [
                {
                  "required": [
                    "dock_source_sha256"
                  ]
                },
                {
                  "required": [
                    "dock_foundations"
                  ]
                }
              ]
            }
          }
        }
      ]
    },
    "schema": {
      "const": "projectseele.r52.mechanical-owner.v1"
    },
    "map_author": {
      "const": "root"
    },
    "status": {
      "enum": [
        "design",
        "installed"
      ]
    },
    "epoch": {
      "type": "integer",
      "minimum": 1
    },
    "directory_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "commissioning_receipt_sha256": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "mechanism_sources": {
      "type": "object",
      "required": [
        "mesh/tv_shoulder_shells_r44.json"
      ],
      "additionalProperties": {
        "type": "string",
        "pattern": "^[0-9a-f]{64}$"
      }
    },
    "units": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/unit"
      },
      "minItems": 3,
      "maxItems": 3
    },
    "gates": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/gate"
      },
      "minItems": 1
    },
    "resources": {
      "type": "object",
      "additionalProperties": {
        "$ref": "#/$defs/fixed_cells"
      }
    },
    "receivers": {
      "type": "array",
