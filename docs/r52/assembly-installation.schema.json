    "schema": {
      "const": "projectseele.r52.assembly-installation.v1"
    },
    "map_author": {
      "const": "root"
    },
    "status": {
      "enum": [
        "design",
        "installed"
      ]
    },
    "dimension": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_./:-]{1,160}$"
    },
    "epoch": {
      "type": "integer",
      "minimum": 1
    },
    "directory_fingerprint": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    },
    "directory": {
      "type": "object",
      "properties": {
        "file": {
          "type": "string",
          "pattern": "^(?!.*(?:\\.\\.|:|^[\\\\/])).+$"
        },
        "sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        }
      },
      "required": [
        "file",
        "sha256"
      ],
