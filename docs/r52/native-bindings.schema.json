{
  "type": "array",
  "items": {
    "type": "object",
    "properties": {
      "resource": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_./:-]{1,160}$"
      },
      "component": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_./:-]{1,160}$"
      },
      "entity_uuid": {
        "type": "string",
        "format": "uuid"
      },
      "expected_type": {
        "type": "string",
        "pattern": "^[A-Za-z0-9_./:-]{1,160}$"
      },
      "cells": {
        "$ref": "#/$defs/fixed_cells"
      },
      "spaces": {
        "type": "array",
        "items": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 6,
          "maxItems": 6
        },
        "minItems": 1
      },
      "required_open": {
        "type": "number",
        "exclusiveMinimum": 0,
        "maximum": 1
      },
      "mechanical_rail": {
        "type": "object",
        "properties": {
          "kind": {
            "enum": [
              "FIXED_FOOT_GUIDE",
              "FOOT_TURN_STATION",
              "LEGACY_RUNNING_HEAD",
              "UPRIGHT_CAPTURED_GUIDEWAY"
            ]
          },
          "leg": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_./:-]{1,160}$"
          },
          "source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "guide_source_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "floor_overlay_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "service_overlay_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "level_overlay_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          },
          "controller_uuid": {
            "type": [
              "string",
              "null"
            ],
            "format": "uuid"
          },
          "foundation_top_m": {
            "type": [
              "number",
              "null"
            ]
          },
          "deep_frame_sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "kind",
          "leg",
          "source_sha256",
          "guide_source_sha256"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "LEGACY_RUNNING_HEAD"
                }
              },
              "required": [
                "kind"
              ]
            },
            "then": {
              "required": [
                "floor_overlay_sha256",
                "service_overlay_sha256",
                "level_overlay_sha256",
                "deep_frame_sha256"
              ]
            },
            "else": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "floor_overlay_sha256"
                    ]
                  },
                  {
                    "required": [
                      "service_overlay_sha256"
                    ]
                  },
                  {
                    "required": [
                      "level_overlay_sha256"
                    ]
                  },
                  {
                    "required": [
                      "deep_frame_sha256"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "FIXED_FOOT_GUIDE"
                }
              }
            },
            "then": {
              "not": {
                "anyOf": [
                  {
                    "required": [
                      "controller_uuid"
                    ]
                  },
                  {
                    "required": [
                      "foundation_top_m"
                    ]
                  }
                ]
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "FOOT_TURN_STATION"
                }
              }
            },
            "then": {
              "required": [
                "controller_uuid",
                "foundation_top_m"
              ],
              "properties": {
                "controller_uuid": {
                  "type": "string",
                  "format": "uuid"
                },
                "foundation_top_m": {
                  "type": "number"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "LEGACY_RUNNING_HEAD"
                }
              }
            },
            "then": {
              "required": [
                "controller_uuid"
              ],
              "not": {
                "required": [
                  "foundation_top_m"
                ]
              },
              "properties": {
                "controller_uuid": {
                  "type": "string",
                  "format": "uuid"
                }
              }
            }
          },
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "UPRIGHT_CAPTURED_GUIDEWAY"
                }
              }
            },
            "then": {
              "required": [
                "controller_uuid",
                "foundation_top_m"
              ],
              "properties": {
                "controller_uuid": {
                  "type": "null"
                },
                "foundation_top_m": {
                  "type": "null"
                }
              }
            }
          }
        ]
      }
    },
    "required": [
      "resource",
      "component"
    ],
    "additionalProperties": false,
    "allOf": [
      {
        "if": {
          "required": [
            "mechanical_rail"
          ]
        },
        "then": {
          "required": [
            "cells"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "entity_uuid"
                ]
              },
              {
                "required": [
                  "spaces"
                ]
              },
              {
                "required": [
                  "required_open"
                ]
              }
            ]
          }
        }
      }
    ]
  },
  "minItems": 1,
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "projectseele:r52:native-bindings",
  "$defs": {
    "fixed_cell": {
      "type": "object",
      "properties": {
        "position": {
          "$ref": "#/$defs/cell_position"
        },
        "state": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "position",
        "state"
      ],
      "additionalProperties": false
    },
    "fixed_cells": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/fixed_cell"
      },
      "minItems": 1
    },
    "cell_position": {
      "type": "array",
      "items": {
        "type": "integer"
      },
      "minItems": 3,
      "maxItems": 3
    }
  },
  "description": "Production parser additionally enforces exact rail kind/path/source/finite foundations and complete unique resource set. Mechanical foundation cells are not block rails and never exempt triangle collisions."
}
